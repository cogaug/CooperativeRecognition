<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/tosm#"
     xml:base="http://www.semanticweb.org/tosm"
     xmlns:xs="http://www.w3.org/TR/xmlschema-2/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/tosm">
        <owl:versionIRI rdf:resource="http://www.semanticweb.org/tosm/1.1.0"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2000/01/rdf-schema#Literal">The TOSM-based database for the SKKU environment.</rdfs:comment>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->

    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/tosm#canNotGoThrough -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tosm#canNotGoThrough">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#robotRelation"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tosm#Robot"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tosm#Place"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tosm#canNotRotateInPlace -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tosm#canNotRotateInPlace">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#robotRelation"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tosm#Robot"/>
        <rdfs:range>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/tosm#isLeafPlace"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
            </owl:Restriction>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tosm#canWorkingAt -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tosm#canWorkingAt">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#robotRelation"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tosm#Robot"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tosm#Place"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tosm#consistsOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tosm#consistsOf">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#spatialRelation"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/tosm#isInsideOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tosm#isAboveOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tosm#isAboveOf">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#spatialRelation"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tosm#Object"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tosm#Object"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tosm#isBehindOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tosm#isBehindOf">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#spatialRelation"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tosm#Object"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tosm#Object"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tosm#isConnectedTo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tosm#isConnectedTo">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#spatialRelation"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tosm#Place"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tosm#Place"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tosm#isInFrontOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tosm#isInFrontOf">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#spatialRelation"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tosm#Object"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tosm#Object"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tosm#isInsideOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tosm#isInsideOf">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#spatialRelation"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/tosm#Object"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/tosm#Place"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tosm#Place"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tosm#isLocatedAt -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tosm#isLocatedAt">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#robotRelation"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tosm#Robot"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tosm#Place"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tosm#isLookingAt -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tosm#isLookingAt">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#robotRelation"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tosm#Robot"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/tosm#Object"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/tosm#Place"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tosm#isNextTo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tosm#isNextTo">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#spatialRelation"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tosm#Object"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tosm#Object"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tosm#isOn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tosm#isOn">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#spatialRelation"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tosm#Object"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tosm#Object"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tosm#isWorkingWith -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tosm#isWorkingWith">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#robotRelation"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tosm#Robot"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tosm#Robot"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tosm#robotRelation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tosm#robotRelation">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tosm#spatialRelation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tosm#spatialRelation">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/tosm#ID -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tosm#ID">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#symbolicModel"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/tosm#Object"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/tosm#Place"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/tosm#Robot"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tosm#StringID -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tosm#StringID">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#symbolicModel"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tosm#Object"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tosm#assignedMissionAt -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tosm#assignedMissionAt">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#implicitModel"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tosm#Robot"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tosm#availableEndTime -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tosm#availableEndTime">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#implicitModel"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/tosm#Door"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/tosm#Doorway"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tosm#availableStartTime -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tosm#availableStartTime">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#implicitModel"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/tosm#Door"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/tosm#Doorway"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tosm#availableTime -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tosm#availableTime">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#implicitModel"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/tosm#Door"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/tosm#Doorway"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tosm#boundary -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tosm#boundary">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#explicitModel"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tosm#Place"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>[[x1,y1,z1], ... [xn,yn,zn]]</rdfs:comment>
        <rdfs:comment>boundary</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tosm#canBeOpen -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tosm#canBeOpen">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#implicitModel"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tosm#Door"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tosm#canBeOpenedByRobot -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tosm#canBeOpenedByRobot">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#implicitModel"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tosm#Elevator"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tosm#capability -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tosm#capability">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#implicitModel"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tosm#Robot"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tosm#color -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tosm#color">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#explicitModel"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tosm#Object"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tosm#complexity -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tosm#complexity">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#implicitModel"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tosm#Place"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tosm#coordinateFrame -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tosm#coordinateFrame">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#explicitModel"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/tosm#Object"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/tosm#Place"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/tosm#Robot"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tosm#electricalSpecification -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tosm#electricalSpecification">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#explicitModel"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tosm#entranceSize -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tosm#entranceSize">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#explicitModel"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/tosm#Door"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/tosm#Doorway"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tosm#explicitModel -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tosm#explicitModel">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tosm#footPrintSize -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tosm#footPrintSize">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#explicitModel"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tosm#Robot"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tosm#implicitModel -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tosm#implicitModel">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tosm#isKeyObject -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tosm#isKeyObject">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#implicitModel"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tosm#Object"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tosm#isLeafPlace -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tosm#isLeafPlace">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#implicitModel"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tosm#Place"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2000/01/rdf-schema#Literal">The implicit model of Place.
This property means the place is a leaf place that doesn&apos;t have any child place represented by isInsideOf property.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tosm#isMovable -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tosm#isMovable">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#implicitModel"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tosm#Object"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tosm#isOpen -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tosm#isOpen">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#explicitModel"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tosm#Door"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tosm#kinematicFrame -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tosm#kinematicFrame">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#explicitModel"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tosm#level -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tosm#level">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#implicitModel"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tosm#Floor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tosm#mechanicalSpecification -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tosm#mechanicalSpecification">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#explicitModel"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tosm#name -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tosm#name">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#symbolicModel"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/tosm#Object"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/tosm#Place"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/tosm#Robot"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tosm#objectType -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tosm#objectType">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#implicitModel"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tosm#Object"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tosm#pose -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tosm#pose">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#explicitModel"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tosm#Object"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>[x, y, z, quaternion.x, quaternion.y, quaternion.z, quaternion.w]</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tosm#roomNumber -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tosm#roomNumber">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#implicitModel"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tosm#Room"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tosm#size -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tosm#size">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#explicitModel"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tosm#Object"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>[x, y, z]</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tosm#symbolicModel -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tosm#symbolicModel">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tosm#usage -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tosm#usage">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#implicitModel"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/tosm#Robot"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/tosm#Room"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tosm#velocity -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tosm#velocity">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tosm#explicitModel"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tosm#Object"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


